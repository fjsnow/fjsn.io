---
import Root from '@/layouts/Root.astro';
import Header from '@/components/index/Header.astro';
import Experience from '@/components/index/Experience.astro';
import Posts from '@/components/index/Posts.astro';
import Metadata from '@/components/Metadata.astro';
---

<Metadata
    title="Freddy Snow"
    description="Freddy Snow is a 21 y/o developer from the UK."
    url={import.meta.env.SITE}
    og={{
        image: import.meta.env.SITE + '/og/index.png',
        type: 'website',
    }}
/>
<Root showFidget>
    <div class="flex flex-col gap-8">
        <Header />
        <Experience />
        <Posts />
    </div>
</Root>
