---
import '@/global.css';
import Layout from '@/layouts/Layout.astro';

import '@fontsource-variable/jetbrains-mono';
import jetBrainsMonoWoff2 from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2';

interface Props {
    showFidget?: boolean;
}

const { showFidget = false } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <meta name="format-detection" content="telephone=no" />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <link
            rel="preload"
            as="font"
            type="font/woff2"
            href={jetBrainsMonoWoff2}
            crossorigin="anonymous"
        />
        <script>
            const theme = localStorage.getItem('theme');
            if (theme)
                document.documentElement.setAttribute('data-theme', theme);
        </script>
        <noscript>
            <style>
                .js-only {
                    display: none;
                }
            </style>
        </noscript>
    </head>
    <body
        class="bg-[#FCFCFC] font-sans font-[450] text-stone-950 antialiased dark:bg-[#151515] dark:text-stone-50"
    >
        <Layout showFidget={showFidget}>
            <slot />
        </Layout>
    </body>
</html>
