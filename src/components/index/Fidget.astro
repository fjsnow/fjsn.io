---
const columns = 50;
const rows = 5;
const activeSelector = ':is(:hover, :active, .is-active)';
const verticalProximityRules = Array.from({ length: columns }, (_, index) => {
    const hoveredColumn = index + 1;
    const selectors = [];

    for (const targetColumn of [
        hoveredColumn - 1,
        hoveredColumn,
        hoveredColumn + 1,
    ]) {
        if (targetColumn < 1 || targetColumn > columns) continue;
        const scale = targetColumn === hoveredColumn ? '1.85' : '1.35';
        const nextRowTarget = `.fidget-row:has(.fidget-dot:nth-child(${hoveredColumn})${activeSelector}) + .fidget-row .fidget-dot:nth-child(${targetColumn})`;
        const previousRowTarget = `.fidget-row:has(+ .fidget-row .fidget-dot:nth-child(${hoveredColumn})${activeSelector}) .fidget-dot:nth-child(${targetColumn})`;
        selectors.push(
            `${nextRowTarget}::before,
            ${nextRowTarget}::after,
            ${previousRowTarget}::before,
            ${previousRowTarget}::after { transform: translate(-50%, -50%) scale(${scale}); }`,
            `${nextRowTarget}::after,
            ${previousRowTarget}::after { opacity: 1; }`
        );
    }

    return selectors.join('\n');
}).join('\n');
---

<div class="fidget" aria-label="Interactive colour fidget">
    <div class="fidget-track">
        {
            Array.from({ length: rows }, () => (
                <div class="fidget-row">
                    {Array.from({ length: columns }, () => (
                        <span class="fidget-dot" />
                    ))}
                </div>
            ))
        }
    </div>
</div>

<style is:global set:html={verticalProximityRules}></style>

<style>
    .fidget {
        --fidget-color: #e7e5e4;
        --fidget-hover-color: #a79cc7;
        --fidget-cell-size: 13px;
        --fidget-dot-size: 4px;
        width: 100%;
        height: 56px;
        overflow: hidden;
        touch-action: none;
    }

    .fidget-track {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
    }

    .fidget-row {
        display: flex;
        flex: 1;
        justify-content: center;
        min-height: 0;
    }

    .fidget-dot {
        position: relative;
        display: block;
        flex: 0 0 var(--fidget-cell-size);
        width: var(--fidget-cell-size);
        min-height: 0;
    }

    .fidget-dot::before,
    .fidget-dot::after {
        position: absolute;
        top: 50%;
        left: 50%;
        display: block;
        width: var(--fidget-dot-size);
        height: var(--fidget-dot-size);
        border-radius: 9999px;
        content: '';
        pointer-events: none;
        transform: translate(-50%, -50%) scale(1);
    }

    .fidget-dot::before {
        background: var(--fidget-color);
        transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .fidget-dot::after {
        background: var(--fidget-hover-color);
        opacity: 0;
        transition:
            transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
            opacity 220ms ease;
    }

    .fidget-dot:is(:hover, :active, .is-active)::before,
    .fidget-dot:is(:hover, :active, .is-active)::after {
        transform: translate(-50%, -50%) scale(2.8);
    }

    .fidget-dot:is(:hover, :active, .is-active)::after {
        opacity: 1;
    }

    .fidget-dot:has(+ .fidget-dot:is(:hover, :active, .is-active))::before,
    .fidget-dot:is(:hover, :active, .is-active) + .fidget-dot::before,
    .fidget-dot:has(+ .fidget-dot:is(:hover, :active, .is-active))::after,
    .fidget-dot:is(:hover, :active, .is-active) + .fidget-dot::after {
        transform: translate(-50%, -50%) scale(1.85);
    }

    .fidget-dot:has(+ .fidget-dot:is(:hover, :active, .is-active))::after,
    .fidget-dot:is(:hover, :active, .is-active) + .fidget-dot::after {
        opacity: 1;
    }

    .fidget-dot:has(
            + .fidget-dot + .fidget-dot:is(:hover, :active, .is-active)
        )::before,
    .fidget-dot:is(:hover, :active, .is-active)
        + .fidget-dot
        + .fidget-dot::before,
    .fidget-dot:has(
            + .fidget-dot + .fidget-dot:is(:hover, :active, .is-active)
        )::after,
    .fidget-dot:is(:hover, :active, .is-active)
        + .fidget-dot
        + .fidget-dot::after {
        transform: translate(-50%, -50%) scale(1.35);
    }

    .fidget-dot:has(
            + .fidget-dot + .fidget-dot:is(:hover, :active, .is-active)
        )::after,
    .fidget-dot:is(:hover, :active, .is-active)
        + .fidget-dot
        + .fidget-dot::after {
        opacity: 1;
    }

    :global([data-theme='dark'] .fidget) {
        --fidget-color: #292524;
        --fidget-hover-color: #6f63bd;
    }

    @media (prefers-color-scheme: dark) {
        :global(html:not([data-theme='light']) .fidget) {
            --fidget-color: #292524;
            --fidget-hover-color: #6f63bd;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .fidget-dot::before,
        .fidget-dot::after {
            transition: none;
        }
    }
</style>

<script>
    document.querySelectorAll('.fidget').forEach((fidget) => {
        if (!(fidget instanceof HTMLElement)) return;

        let activeDot: HTMLElement | undefined;
        let isDragging = false;

        const updateActiveDot = (clientX: number, clientY: number) => {
            const dot = document
                .elementFromPoint(clientX, clientY)
                ?.closest('.fidget-dot');

            if (!(dot instanceof HTMLElement) || !fidget.contains(dot)) {
                return;
            }

            if (activeDot === dot) return;
            activeDot?.classList.remove('is-active');
            activeDot = dot;
            activeDot.classList.add('is-active');
        };

        const clearActiveDot = () => {
            if (!isDragging) return;

            isDragging = false;
            activeDot?.classList.remove('is-active');
            activeDot = undefined;
        };

        fidget.addEventListener('touchstart', (event) => {
            const touch = event.touches[0];
            if (!touch) return;

            isDragging = true;
            updateActiveDot(touch.clientX, touch.clientY);
        });
        fidget.addEventListener(
            'touchmove',
            (event) => {
                if (!isDragging) return;
                event.preventDefault();

                const touch = event.touches[0];
                if (touch) updateActiveDot(touch.clientX, touch.clientY);
            },
            { passive: false }
        );
        fidget.addEventListener('touchend', clearActiveDot);
        fidget.addEventListener('touchcancel', clearActiveDot);
    });
</script>
